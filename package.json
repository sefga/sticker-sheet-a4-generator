{
  "name": "stickerfit",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "description": "Free A4 sticker sheet layout maker & print-ready 1:1 vector PDF generator with exact millimeter precision (StickerFit)",
  "homepage": "https://stickerfit.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sefga/stickerfit.git"
  },
  "bugs": {
    "url": "https://github.com/sefga/stickerfit/issues"
  },
  "keywords": [
    "sticker-sheet",
    "sticker-sheet-maker",
    "sticker-generator",
    "print-ready",
    "label-maker",
    "a4-stickers",
    "vector-pdf",
    "papercraft",
    "stationery",
    "merch-maker",
    "print-calculator",
    "client-side",
    "open-source",
    "stickers",
    "pdf"
  ],
  "author": "Михаил Сокольский (sefga)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "critic": "node scripts/apple-design-critic.mjs",
    "critic:5": "node scripts/critic-5-cycles.mjs",
    "critic:personas": "node scripts/multi-persona-critic.mjs",
    "critic:guide-ux": "node scripts/guide-close-ux-critic.mjs",
    "audit:speed": "node scripts/performance-critic.mjs",
    "eval": "vitest run && tsc && vite build && node scripts/apple-design-critic.mjs && node scripts/performance-critic.mjs && node scripts/guide-close-ux-critic.mjs && node scripts/critic-5-cycles.mjs && node scripts/multi-persona-critic.mjs",
    "critic:mobile": "node scripts/critic-mobile-modals.mjs",
    "screenshots": "node scripts/capture-readme-screenshots.mjs",
    "critic:github": "node scripts/github-presentation-critic.mjs",
    "deploy:netlify": "npx netlify-cli deploy --prod --dir=dist"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "cropperjs": "^1.6.2",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/cropperjs": "^1.3.3",
    "@types/node": "^22.10.2",
    "puppeteer-core": "^25.10.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
