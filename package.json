{
  "name": "stickerfit",
  "private": true,
  "version": "1.0.0",
  "description": "Автоматический генератор раскладки наклеек на листе A4 для печати с физической точностью в миллиметрах (StickerFit)",
  "homepage": "https://stickerfit.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sefga/stickerfit.git"
  },
  "bugs": {
    "url": "https://github.com/sefga/stickerfit/issues"
  },
  "keywords": [
    "stickers",
    "sticker-sheet",
    "print-ready",
    "a4",
    "pdf",
    "cropperjs",
    "vite",
    "typescript"
  ],
  "author": "Михаил Сокольский (sefga)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "critic": "node scripts/apple-design-critic.mjs",
    "critic:5": "node scripts/critic-5-cycles.mjs",
    "critic:personas": "node scripts/multi-persona-critic.mjs",
    "audit:speed": "node scripts/performance-critic.mjs",
    "eval": "vitest run && tsc && vite build && node scripts/apple-design-critic.mjs && node scripts/performance-critic.mjs && node scripts/critic-5-cycles.mjs && node scripts/multi-persona-critic.mjs",
    "screenshots": "node scripts/capture-readme-screenshots.mjs",
    "deploy:netlify": "npx netlify-cli deploy --prod --dir=dist"
  },
  "dependencies": {
    "cropperjs": "^1.6.2",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/cropperjs": "^1.3.3",
    "@types/node": "^22.10.2",
    "puppeteer-core": "^25.10.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
