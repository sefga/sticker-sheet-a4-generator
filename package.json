{
  "name": "sticker-sheet-a4-generator",
  "private": true,
  "version": "1.0.0",
  "description": "Автоматический генератор раскладки наклеек на листе A4 для печати с физической точностью в миллиметрах",
  "homepage": "https://sticker-sheet-a4-generator.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sefga/sticker-sheet-a4-generator.git"
  },
  "keywords": [
    "stickers",
    "sticker-sheet",
    "print-ready",
    "a4",
    "pdf",
    "cropperjs",
    "vite",
    "typescript"
  ],
  "author": "Михаил Сокольский (sefga)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy:netlify": "npx netlify-cli deploy --prod --dir=dist"
  },
  "dependencies": {
    "cropperjs": "^1.6.2",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/cropperjs": "^1.3.3",
    "@types/node": "^22.10.2",
    "puppeteer-core": "^25.10.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
